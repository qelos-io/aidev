{
  "name": "@qelos/aidev",
  "version": "1.7.0",
  "description": "AI-powered task executor — polls ClickUp (and more) to implement tasks with Claude, Cursor, Devin, or Antigravity",
  "type": "commonjs",
  "bin": {
    "aidev": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "ui/.output",
    "ui/package.json",
    ".env.aidev.example"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && node -e \"if(process.platform!=='win32')require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "build:ui": "npm --prefix ui ci && npm --prefix ui run build",
    "dev": "tsx src/cli.ts",
    "test": "node scripts/run-tests.cjs",
    "prepublishOnly": "npm run build && npm run build:ui"
  },
  "keywords": [
    "ai",
    "cli",
    "clickup",
    "claude",
    "cursor",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qelos-io/aidev.git"
  },
  "bugs": {
    "url": "https://github.com/qelos-io/aidev/issues"
  },
  "homepage": "https://qelos-io.github.io/aidev/",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
